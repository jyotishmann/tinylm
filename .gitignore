# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ─────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── PyTorch checkpoints (large binary files — use GDrive/HF Hub) ────
*.pt
*.pth
*.bin
*.safetensors

# ── Training artefacts ───────────────────────────────────────────────
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep
wandb/
runs/

# ── Raw & processed data (reproducible via download.py) ─────────────
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ── Environment variables (secrets) ─────────────────────────────────
.env
.env.local
.env.*.local

# ── Frontend ─────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── IDEs ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Jupyter ──────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Testing ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/